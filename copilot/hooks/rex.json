{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "context=$(rex __internal session-start --agent=copilot --feature-session-naming=false) && jq -n --arg context \"$context\" '{additionalContext: $context}'",
        "timeoutSec": 5
      }
    ]
  }
}
