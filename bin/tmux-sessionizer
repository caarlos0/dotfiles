#!/usr/bin/env fish
# I organize my projects in ~/Developer/org/name, and I'd like to create sessions for each of them.
# This script uses a combination of zoxide (so they are sort by frecency) and fzf to list and filter project folders.
# Then, it either switch to an existing tmux session for that project, or create a new one and switch to it.
#
# Stole and modified from: https://github.com/ThePrimeagen/.dotfiles/blob/master/bin/.local/bin/tmux-sessionizer

# increase frecency
function increase
    set selected "$argv[1]"
    if test "$selected" = default
        return 0
    end
    zoxide add $PROJECTS/$selected
end

function search
    # One `zoxide` dump instead of one query per org folder: 4 processes
    # instead of ~20, which measures 4-25x faster depending on machine load.
    # zoxide also drops entries whose directory is gone, so `find` is redundant.
    zoxide query -l -s |
        awk -v prefix="$PROJECTS/" '
            {
                path = $0
                sub(/^ *[0-9.]+ +/, "", path) # strip the score off the path
                if (index(path, prefix) != 1) next # keep only ~/Developer/*
                rel = substr(path, length(prefix) + 1)
                slash = index(rel, "/")
                # keep only org/name: drop the bare org and deeper subfolders
                if (slash == 0 || index(substr(rel, slash + 1), "/")) next
                print $1 "\t" rel
            }' |
        sort -rnk1 | # sort by score
        cut -f2 | # do not actually print the score
        fzf-tmux -p --no-sort --prompt "  "
end

if test (count $argv) -eq 1
    set selected "$argv[1]"
else
    set selected $(search)
end

if test -z $selected
    exit 0
end

set selected_name (basename "$selected" | tr . _)
set tmux_running (pgrep tmux)

if test -z "$TMUX" && test -z "$tmux_running"
    tmux new-session -s "$selected_name" -c "$PROJECTS/$selected"
    increase "$selected"
    exit 0
end

if ! tmux has-session -t="$selected_name" 2>/dev/null
    tmux new-session -ds "$selected_name" -c "$PROJECTS/$selected"
end

tmux switch-client -t "$selected_name"
increase "$selected"
