#!/bin/sh
set -eu

slot_root=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/rustc-wrapper-$(id -u)
mkdir -p "$slot_root"

while :; do
  for slot in 1 2; do
    slot_dir=$slot_root/$slot
    if mkdir "$slot_dir" 2>/dev/null; then
      trap 'rmdir "$slot_dir"' 0
      sccache "$@"
      exit
    fi
  done
  echo "No available build slots, waiting for one to become available..." >&2
  sleep 10
done
