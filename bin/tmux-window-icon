#!/usr/bin/env fish
# Print the Nerd Font glyph for a tmux tab, based on the command running in the pane.
#
# Meant for tmux window-status-format, taking the pane's current command, e.g.:
#   "... #I #(tmux-window-icon #{pane_current_command}) #{b:pane_current_path} ..."
#
# tmux re-expands every window's status line on each redraw, so this stays a
# single builtin switch: no subprocesses, no cache, no network.

# Nerd Font icon for a command name (merged from bin/icons), or nothing.
function command_icon
    switch $argv[1]
        case ack fd find fzf grep rg
            echo 
        case atop htop top
            echo 
        case bash fish zsh sh ash
            echo 
        case bat cat
            echo 
        case clx
            echo 
        case copilot
            echo 
        case cp duplicate
            echo 
        case diff
            echo 
        case mv
            echo 󰉒
        case curl http pint lynx wget w3m
            echo 
        case docker docker-compose podman
            echo 
        case lf ls nnn ranger lsd
            echo 
        case elixir mix
            echo 
        case prowl
            printf '\U000f03d2' # nf-md-owl
        case gh gh-dash
            echo 
        case git lazygit tig
            echo 
        case glow
            echo 
        case go goreleaser
            echo 
        case java mvn
            echo 
        case less more
            echo 
        case lua
            echo 
        case man
            echo 
        case nano pico
            echo 
        case node
            echo 
        case npm pnpm
            echo 
        case 'nix*'
            echo 󱄅
        case vim vi
            echo 
        case nvim
            echo 
        case python pip
            echo 
        case rm
            echo 
        case rsync
            echo 
        case rust cargo rustup
            echo 
        case ruby irb
            echo 
        case scp ssh
            echo 󰣀
        case sleep
            echo 
        case sudo
            echo 
        case tail
            echo 
        case task make
            echo 
        case tmux
            echo 
        case youtube-dl
            echo 
        case age bw gpg op pass pinentry
            echo 
        case ansible
            echo 
        case bun
            echo 
        case composer
            echo 
        case deno
            echo 󰟓
        case dig nslookup ping traceroute mtr nc netcat nmap tcpdump
            echo 󰛳
        case du df ncdu dust
            echo 󰋊
        case eslint
            echo 
        case ffmpeg mpv yt-dlp
            echo 
        case helm
            echo 󰠳
        case imagemagick magick convert
            echo 
        case jq yq
            echo 󰘦
        case mongo mongosh
            echo 
        case mysql mariadb
            echo 
        case openssl
            echo 
        case psql
            echo 
        case redis-cli
            echo 
        case screen
            echo 
        case sqlite sqlite3
            echo 
        case swift
            echo 
        case tar zip unzip gzip gunzip
            echo 
        case terraform tofu tflint
            echo 
        case time
            echo 
        case tsc
            echo 
        case watch
            echo 
        case xcodebuild
            echo 
        case yarn
            echo 
        case zig
            echo 
    end
end

# Icon for the command, falling back to a generic terminal glyph (Nerd Font f489)
# when nothing matches. Only a known glyph ever reaches stdout.
set -l out (command_icon $argv[-1])
test -z "$out"; and set out (printf '\uf489')
printf '%s' $out
