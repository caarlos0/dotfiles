#!/usr/bin/env fish

argparse k/keep t/tab s/split -- $argv
or exit 1

if set -q _flag_tab; and set -q _flag_split
    echo "review: --tab and --split are mutually exclusive" >&2
    exit 1
end

set -l prompt "/my-code-review this branch."

if set -q _flag_keep
    set prompt "$prompt
Keep reviewing every new push until the PR is merged or closed."
end

set -l cmd copilot --yolo \
    --autopilot \
    --agent caarlos0 \
    --effort medium \
    --context long_context \
    --model gpt-6.1-sol \
    --sandbox \
    -i "$prompt"

if not set -q argv[1]
    exec $cmd
end

set -l mode
set -q _flag_tab; and set mode --tab
set -q _flag_split; and set mode --split

if test (count $argv) -gt 1; and test -z "$mode"
    echo "review: several PRs need --tab or --split" >&2
    exit 1
end

for pr in $argv
    wt $mode --pr $pr -- $cmd
    or exit 1
end
