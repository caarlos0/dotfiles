#!/usr/bin/env fish

argparse h/help k/keep t/tab s/split -- $argv
or exit 1

if set -q _flag_help
    echo "NAME:
  review - review the current branch or pull requests with Copilot

USAGE:
  review [options] [<pr>...]

ARGUMENTS:
  <pr>          pull request number; several require --tab or --split

OPTIONS:
  --keep,-k     keep reviewing new pushes until the PR is merged or closed
  --tab,-t      open each review in a new Rex tab without focusing it
  --split,-s    open each review in a new Rex split without focusing it
  --help,-h     show help

Without a PR, reviews the current branch. Without --tab or --split,
the review runs in the current pane."
    exit 0
end

if set -q _flag_tab; and set -q _flag_split
    echo "review: --tab and --split are mutually exclusive" >&2
    exit 1
end

set -l prompt "use /coding:review and /lever review on this branch."

if set -q _flag_keep
    set prompt "$prompt
Keep reviewing every new push until the PR is merged or closed."
end

set -l cmd copilot --yolo \
    --autopilot \
    --max-autopilot-continues 9007199254740991 \
    --agent coding:caarlos0 \
    --effort medium \
    --context long_context \
    --model gpt-6.1-sol \
    --sandbox \
    -i "$prompt"

set -l mode
set -q _flag_tab; and set mode tab
set -q _flag_split; and set mode split

if not set -q argv[1]
    if test -n "$mode"
        wt --$mode . -- $cmd
        exit $status
    end
    exec $cmd
end

if test (count $argv) -gt 1; and test -z "$mode"
    echo "review: several PRs need --tab or --split" >&2
    exit 1
end

set -l wt_mode
test -n "$mode"; and set wt_mode --$mode
for pr in $argv
    wt $wt_mode --pr $pr -- $cmd
    or exit 1
end
