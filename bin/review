#!/usr/bin/env fish

argparse k/keep -- $argv
or exit 1

set -l prompt "/review Use the code-review skill."

if set -q _flag_keep
    set prompt "$prompt
Keep reviewing every new push until the PR is merged or closed."
end

set -l cmd copilot --yolo \
    --autopilot \
    --agent caarlos0 \
    --effort high \
    --context long_context \
    --sandbox \
    -i "$prompt"

if set -q argv[1]
    exec wt --pr $argv[1] -- $cmd
end
exec $cmd
