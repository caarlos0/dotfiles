#!/usr/bin/env fish

argparse k/keep -- $argv
or exit 1

set -l prompt "/code-review this branch."

if set -q _flag_keep
    set prompt "$prompt
Keep reviewing every new push until the PR is merged or closed."
end

set -l cmd copilot --yolo \
    --autopilot \
    --agent caarlos0 \
    --effort medium \
    --context long_context \
    --model gpt-6.1-sol \
    --sandbox \
    -i "$prompt"

if not set -q argv[1]
    exec $cmd
end

# one split for a single PR; tabs for a list so the origin pane isn't squeezed
set -l mode --split
test (count $argv) -gt 1; and set mode --tab
for pr in $argv
    wt $mode --pr $pr -- $cmd
    or exit 1
end
