#!/bin/sh
# Blocks until a new commit is pushed to a pull request, then prints the new
# head SHA. Prints nothing while waiting, so an agent can call it in a loop
# without filling its context.
#
# usage: gh wait-push [<pr>] [<sha>]
#   <pr>   pull request number (default: the PR of the current branch)
#   <sha>  last reviewed commit (default: HEAD)
#
# Exits 1 when the pull request is merged or closed.
set -e

pr="${1:-$(gh pr view --json number --jq .number)}"
sha="${2:-$(git rev-parse HEAD)}"

pr_state() {
  gh pr view "$pr" --json state,headRefOid --jq '.state + " " + .headRefOid'
}

# fail fast on a bad PR, but ignore transient errors while waiting
out=$(pr_state)
while :; do
  if [ -n "$out" ]; then
    state="${out% *}"
    head="${out#* }"
    if [ "$state" != OPEN ]; then
      echo "pull request #$pr is $(echo "$state" | tr '[:upper:]' '[:lower:]')" >&2
      exit 1
    fi
    if [ "$head" != "$sha" ]; then
      echo "new push on #$pr: $sha..$head"
      exit 0
    fi
  fi
  sleep 30
  out=$(pr_state 2>/dev/null) || out=
done
