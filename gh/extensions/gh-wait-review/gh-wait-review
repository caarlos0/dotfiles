#!/bin/sh
set -e

usage() {
  cat <<'EOF'
Wait for a submitted review on the current pull request head.

Usage: gh wait-review [<number> | <url> | <branch>]

Examples:
  gh wait-review
  gh wait-review 123
  GH_REPO=OWNER/REPO gh wait-review 123

Defaults to the PR of the current branch. Checks every 30 seconds and follows
new pushes. An existing review on the current head also counts. Draft reviews
and issue comments do not count; a dismissed review still counts as submitted.

Prints matching review URLs, one per line, and stays quiet while waiting.
Exits 0 on a match, 1 if the PR is closed or merged, and 2 for invalid usage.
GitHub CLI errors are printed to stderr and stop the command with nonzero status.

Options:
  -h, --help  Show this help.
EOF
}

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  --) shift ;;
  -*)
    echo "unknown option: $1 (see gh wait-review --help)" >&2
    exit 2
    ;;
esac
if [ "$#" -gt 1 ]; then
  echo "expected at most one PR (see gh wait-review --help)" >&2
  exit 2
fi

pr=$(gh pr view --json id,url --jq '.id + " " + .url' -- "$@")
id="${pr%% *}"
url="${pr#* }"
host="${url#https://}"
host="${host%%/*}"

while :; do
  # shellcheck disable=SC2016
  reviews=$(gh api graphql --hostname "$host" --paginate -f id="$id" -f query='
    query($id: ID!, $endCursor: String) {
      node(id: $id) {
        ... on PullRequest {
          state
          headRefOid
          reviews(first: 100, after: $endCursor) {
            nodes { commit { oid } submittedAt url }
            pageInfo { hasNextPage endCursor }
          }
        }
      }
    }' --jq '
      .data.node |
      if .state != "OPEN" then
        error("pull request is " + (.state | ascii_downcase))
      else
        .headRefOid as $head |
        .reviews.nodes[] |
        select(.submittedAt != null and .commit.oid == $head) |
        .url
      end')
  if [ -n "$reviews" ]; then
    printf '%s\n' "$reviews"
    exit 0
  fi
  sleep 30
done
