#!/bin/sh
set -e

usage() {
  cat <<'EOF'
Show the current user's GitHub API rate limits.

Usage: gh rate-limit [-w | --watch]

Rows are sorted by usage, highest first. Reset times are rounded to the
nearest minute. The GraphQL row comes from the GraphQL API, and each check
costs at least 1 GraphQL point.

Usage percentages are green below 50%, yellow below 80%, and red otherwise.
Reset times are dimmed. A zero limit is shown as n/a.
Styles are disabled when stdout is not a terminal, NO_COLOR is nonempty,
or TERM is dumb.

Options:
  -w, --watch  Redraw the table every 5 minutes until interrupted.
  -h, --help   Show this help.
EOF
}

watch=0
for arg in "$@"; do
  case "$arg" in
    -h | --help)
      usage
      exit 0
      ;;
    -w | --watch) watch=1 ;;
    *)
      printf 'unknown argument: %s (see gh rate-limit --help)\n' "$arg" >&2
      exit 2
      ;;
  esac
done

tty=0
if [ -t 1 ] && [ "$TERM" != dumb ]; then
  tty=1
fi
color=0
if [ "$tty" = 1 ] && [ -z "$NO_COLOR" ]; then
  color=1
fi

table() {
  # /rate_limit can report a different GraphQL window than GraphQL enforces.
  RATE_LIMIT_GRAPHQL=$(gh api graphql -f query='
    { rateLimit { used limit resetAt } }' --jq '
    .data.rateLimit | {used, limit, reset: (.resetAt | fromdateiso8601)}') || return
  export RATE_LIMIT_GRAPHQL
  # shellcheck disable=SC2016
  data=$(gh api rate_limit --jq '
    .resources.graphql = ($ENV.RATE_LIMIT_GRAPHQL | fromjson) |
    .resources | to_entries |
    sort_by([
      (if .value.limit > 0 then -(.value.used / .value.limit) else 1 end),
      .key
    ])[] |
    [.key, .value.used, .value.limit, ([.value.reset - now, 0] | max | floor)] |
    @tsv') || return
  printf '%s\n' "$data" | awk -F '\t' -v color="$color" '
    function dur(s, m) {
      m = int((s + 30) / 60)
      if (m >= 60 && m % 60 == 0) return sprintf("%dh", m / 60)
      if (m >= 60) return sprintf("%dh %dm", m / 60, m % 60)
      return sprintf("%dm", m)
    }
    {
      n++
      subject[n] = $1; used[n] = $2; limit[n] = $3; reset[n] = dur($4)
      if (length($1) > w) w = length($1)
    }
    END {
      if (w < 7) w = 7
      heading = color ? "\033[2mresets in\033[0m" : "resets in"
      printf "%" w "s  %-6s  %s\n", "subject", "used", heading
      separator = sprintf("%" w "s", "")
      gsub(/ /, "-", separator)
      print separator "  ------  ---------"
      for (i = 1; i <= n; i++) {
        pct = limit[i] > 0 ? used[i] * 100 / limit[i] : 0
        usage = sprintf("%-6s", limit[i] > 0 ? sprintf("%.1f%%", pct) : "n/a")
        remaining = reset[i]
        if (color) {
          if (limit[i] > 0) {
            c = pct < 50 ? "32" : pct < 80 ? "33" : "31"
            usage = "\033[" c "m" usage "\033[0m"
          }
          remaining = "\033[2m" remaining "\033[0m"
        }
        printf "%" w "s  %s  %s\n", subject[i], usage, remaining
      }
    }'
}

if [ "$watch" = 0 ]; then
  table
  exit
fi

if [ "$tty" = 1 ]; then
  printf '\033[?25l'
  trap 'printf "\033[?25h"' EXIT
  trap 'exit 130' INT TERM
fi

while :; do
  out=$(table)
  if [ "$tty" = 1 ]; then
    printf '\033[H\033[2J'
  fi
  printf '%s\n' "$out"
  sleep 300
done
