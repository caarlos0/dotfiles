#!/bin/sh
set -e

case "$1" in
  -h | --help)
    cat <<'EOF'
Show the current user's GitHub API rate limits.

Usage: gh rate-limit

Usage percentages are green below 50%, yellow below 80%, and red otherwise.
Reset times are dimmed. A zero limit is shown as n/a.
Styles are disabled when stdout is not a terminal, NO_COLOR is nonempty,
or TERM is dumb.
EOF
    exit 0
    ;;
  "") ;;
  *)
    printf 'unknown argument: %s (see gh rate-limit --help)\n' "$1" >&2
    exit 2
    ;;
esac

color=0
if [ -t 1 ] && [ -z "$NO_COLOR" ] && [ "$TERM" != dumb ]; then
  color=1
fi

data=$(gh api rate_limit --jq '
  .resources | to_entries[] |
  [.key, .value.used, .value.limit, ([.value.reset - now, 0] | max | floor)] |
  @tsv')

printf '%s\n' "$data" |
  awk -F '\t' -v color="$color" '
    function dur(s) {
      if (s >= 3600) return sprintf("%dh %dm", s / 3600, s % 3600 / 60)
      if (s >= 60) return sprintf("%dm %ds", s / 60, s % 60)
      return sprintf("%ds", s)
    }
    {
      n++
      subject[n] = $1; used[n] = $2; limit[n] = $3; reset[n] = dur($4)
      if (length($1) > w) w = length($1)
    }
    END {
      if (w < 7) w = 7
      heading = color ? "\033[2mresets in\033[0m" : "resets in"
      printf "%" w "s  %-6s  %s\n", "subject", "used", heading
      separator = sprintf("%" w "s", "")
      gsub(/ /, "-", separator)
      print separator "  ------  ---------"
      for (i = 1; i <= n; i++) {
        pct = limit[i] > 0 ? used[i] * 100 / limit[i] : 0
        usage = sprintf("%-6s", limit[i] > 0 ? sprintf("%.1f%%", pct) : "n/a")
        remaining = reset[i]
        if (color) {
          if (limit[i] > 0) {
            c = pct < 50 ? "32" : pct < 80 ? "33" : "31"
            usage = "\033[" c "m" usage "\033[0m"
          }
          remaining = "\033[2m" remaining "\033[0m"
        }
        printf "%" w "s  %s  %s\n", subject[i], usage, remaining
      }
    }'
